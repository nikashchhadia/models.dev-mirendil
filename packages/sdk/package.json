{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@mirendil/models-dev",
  "version": "0.1.0",
  "description": "Mirendil-maintained models.dev catalog with explicit canonical base_model mappings",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "homepage": "https://github.com/tetranoir/models.dev-mirendil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetranoir/models.dev-mirendil.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "ai",
    "llm",
    "models",
    "pricing",
    "context-window",
    "openai",
    "anthropic",
    "effect"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "default": "./dist/effect.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot.d.ts",
      "default": "./dist/snapshot.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "bun script/generate.ts",
    "build": "bun script/build.ts",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun run generate && bun run typecheck && bun test"
  },
  "peerDependencies": {
    "effect": "4.0.0-beta.83"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@models.dev/core": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "effect": "4.0.0-beta.83",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
